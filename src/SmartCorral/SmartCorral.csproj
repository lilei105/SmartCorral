<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SmartCorral</RootNamespace>
    <AssemblyName>SmartCorral</AssemblyName>
    <!-- Auto-increment per build: '*' = build (days since 2000-01-01) + revision (sec/2).
         Deterministic must be OFF — the wildcard embeds build time (non-reproducible by design). -->
    <Deterministic>false</Deterministic>
    <NoWarn>CS7035</NoWarn>
    <AssemblyVersion>1.1.*</AssemblyVersion>
    <FileVersion>1.1.*</FileVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Per-Monitor v2 DPI awareness is set in CODE (Interop/DpiBootstrap, a module initializer),
         not here: the WPF-generated Main never calls ApplicationConfiguration.Initialize(), and with
         WinForms enabled the SDK strips dpiAwareness from the manifest (WFO0003) anyway. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is enabled only for the tray (TrayShell.cs imports it explicitly).
         Keep it OUT of global implicit usings so it never clashes with WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
