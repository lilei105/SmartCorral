<interop:NonActivatingWindow x:Class="SmartCorral.Views.FrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:interop="clr-namespace:SmartCorral.Interop"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="380" Height="240"
        MinWidth="180"
        MinHeight="120"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Drop="Frame_Drop"
        DragOver="Frame_DragOver"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseUp"
        PreviewMouseLeftButtonDown="Window_PreviewMouseDown"
        Title="Smart Corral">

    <Border x:Name="RootBorder"
            CornerRadius="14"
            Margin="10"
            Background="#CC1C1C2B"
            BorderBrush="#66FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="New Frame"   Click="NewFrame_Click" />
                <MenuItem Header="Rename…"      Click="Rename_Click" />
                <MenuItem Header="Lock / Unlock" Click="Lock_Click" />
                <MenuItem Header="Roll Up / Down" Click="Roll_Click" />
                <Separator />
                <MenuItem Header="Delete Frame" Click="Delete_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar (drag + double-click to roll) -->
            <Border Grid.Row="0"
                    Background="#22FFFFFF"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <TextBlock x:Name="TitleText"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#FFE8E8F0"
                               VerticalAlignment="Center" />
                    <Button x:Name="CloseBtn"
                            Content="✕"
                            Width="28" Height="28"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#FFCFCFD8" FontSize="12"
                            Cursor="Hand"
                            Click="CloseBtn_Click" />
                </Grid>
            </Border>

            <!-- Items -->
            <ScrollViewer x:Name="ItemsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,4">
                <WrapPanel x:Name="IconsPanel" Margin="10" MinWidth="100" />
            </ScrollViewer>

            <!-- Custom resize grip (bottom-right): magnetic snap + guide lines, like the title drag. -->
            <Border x:Name="ResizeGrip" Grid.Row="1" Width="16" Height="16"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                    Background="#33000000" Cursor="SizeNWSE"
                    MouseLeftButtonDown="ResizeGrip_MouseDown">
                <TextBlock Text="◢" Foreground="#99FFFFFF" FontSize="9"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</interop:NonActivatingWindow>
