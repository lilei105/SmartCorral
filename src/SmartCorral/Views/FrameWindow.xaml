<interop:NonActivatingWindow x:Class="SmartCorral.Views.FrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:interop="clr-namespace:SmartCorral.Interop"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="380" Height="200"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        Title="Smart Corral">

    <Border x:Name="RootBorder"
            CornerRadius="14"
            Margin="10"
            Background="#CC1C1C2B"
            BorderBrush="#66FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar (drag area) -->
            <Border Grid.Row="0"
                    Background="#22FFFFFF"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <TextBlock Text="Smart Corral"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#FFE8E8F0"
                               VerticalAlignment="Center" />
                    <Button x:Name="CloseBtn"
                            Content="✕"
                            Width="28" Height="28"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#FFCFCFD8" FontSize="12"
                            Cursor="Hand"
                            Click="CloseBtn_Click" />
                </Grid>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="18,14">
                <TextBlock Text="你好，灵栅" FontSize="18" FontWeight="Bold" Foreground="#FFF3F3F8" />
                <TextBlock Text="Phase 0 · 把桌面文件拖到这里"
                           FontSize="12" Foreground="#FFB7B7C6"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</interop:NonActivatingWindow>
