<Window x:Class="SmartCorral.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Corral — Settings"
        Width="480" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1C1C2B" Foreground="#FFE8E8F0"
        FontFamily="Segoe UI">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Base URL (OpenAI-compatible)" FontSize="11" Foreground="#FFB7B7C6" Margin="0,0,0,3" />
            <TextBox x:Name="BaseUrlBox" Height="26" Background="#FF2A2A3C" Foreground="White" BorderBrush="#44FFFFFF" Padding="6,3" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="API Key (leave blank for local / no-auth)" FontSize="11" Foreground="#FFB7B7C6" Margin="0,0,0,3" />
            <TextBox x:Name="KeyBox" Height="26" Background="#FF2A2A3C" Foreground="White" BorderBrush="#44FFFFFF" Padding="6,3" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Model" FontSize="11" Foreground="#FFB7B7C6" Margin="0,0,0,3" />
            <TextBox x:Name="ModelBox" Height="26" Background="#FF2A2A3C" Foreground="White" BorderBrush="#44FFFFFF" Padding="6,3" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Icons per frame row (2–8)" FontSize="11" Foreground="#FFB7B7C6" Margin="0,0,0,3" />
            <ComboBox x:Name="IconsPerRowBox" Height="26" Width="80" HorizontalAlignment="Left"
                      Background="#FF2A2A3C" Foreground="White" BorderBrush="#44FFFFFF">
                <ComboBoxItem>2</ComboBoxItem>
                <ComboBoxItem>3</ComboBoxItem>
                <ComboBoxItem>4</ComboBoxItem>
                <ComboBoxItem>5</ComboBoxItem>
                <ComboBoxItem>6</ComboBoxItem>
                <ComboBoxItem>7</ComboBoxItem>
                <ComboBoxItem>8</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <CheckBox Grid.Row="5" x:Name="SeparateFoldersBox" Content="Separate folders onto their own row"
                  FontSize="12" Foreground="#FFE8E8F0" Margin="0,0,0,10" />

        <CheckBox Grid.Row="6" x:Name="ForceTopmostBox" Content="Keep frames always on top"
                  FontSize="12" Foreground="#FFE8E8F0" Margin="0,0,0,10" />

        <TextBlock Grid.Row="7" Text="Tip: OpenAI, DeepSeek, Qwen, or local Ollama (http://localhost:11434/v1) all work."
                   FontSize="10" Foreground="#FF8A8AA0" TextWrapping="Wrap" VerticalAlignment="Bottom" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="90" Height="30" Margin="0,0,8,0" Background="#FF2A2A3C" Foreground="White" BorderBrush="#44FFFFFF" Click="Cancel_Click" />
            <Button Content="Save"   Width="90" Height="30" Background="#FF5B6CFF" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
