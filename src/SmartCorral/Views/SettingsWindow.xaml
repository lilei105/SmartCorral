<Window x:Class="SmartCorral.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Corral — Settings"
        Width="480"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1C1C2B" Foreground="#FFE8E8F0"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: app name + version -->
        <StackPanel Grid.Row="0" Margin="20,16,20,12">
            <TextBlock Text="灵栅 / Smart Corral" FontSize="18" FontWeight="Bold" Foreground="#FFE8E8F0" />
            <TextBlock x:Name="VersionText" FontSize="13" FontWeight="SemiBold" Foreground="#FF8FA0FF" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Scrollable, grouped settings. To add a setting: drop its elements into the matching
             group below — no RowDefinition or window-Height editing needed. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,8">
            <StackPanel>

                <!-- ===== AI 服务 ===== -->
                <TextBlock Text="AI 服务" FontSize="13" FontWeight="Bold" Foreground="#FF8FA0FF" Margin="0,0,0,8" />
                <TextBlock Text="Base URL (OpenAI-compatible)" FontSize="11" Foreground="#FFB7B7C6" Margin="0,0,0,3" />
                <TextBox x:Name="BaseUrlBox" Height="26" Margin="0,0,0,10" Background="#FF2A2A3C" Foreground="White" BorderBrush="#44FFFFFF" Padding="6,3" />
                <TextBlock Text="API Key (leave blank for local / no-auth)" FontSize="11" Foreground="#FFB7B7C6" Margin="0,0,0,3" />
                <TextBox x:Name="KeyBox" Height="26" Margin="0,0,0,10" Background="#FF2A2A3C" Foreground="White" BorderBrush="#44FFFFFF" Padding="6,3" />
                <TextBlock Text="Model" FontSize="11" Foreground="#FFB7B7C6" Margin="0,0,0,3" />
                <TextBox x:Name="ModelBox" Height="26" Margin="0,0,0,16" Background="#FF2A2A3C" Foreground="White" BorderBrush="#44FFFFFF" Padding="6,3" />

                <!-- ===== 外观 / Appearance ===== -->
                <TextBlock Text="外观 / Appearance" FontSize="13" FontWeight="Bold" Foreground="#FF8FA0FF" Margin="0,0,0,8" />
                <TextBlock Text="Icons per frame row (2–8)" FontSize="11" Foreground="#FFB7B7C6" Margin="0,0,0,3" />
                <ComboBox x:Name="IconsPerRowBox" Height="26" Width="80" HorizontalAlignment="Left" Margin="0,0,0,10"
                          Background="#FF2A2A3C" Foreground="White" BorderBrush="#44FFFFFF">
                    <ComboBoxItem>2</ComboBoxItem>
                    <ComboBoxItem>3</ComboBoxItem>
                    <ComboBoxItem>4</ComboBoxItem>
                    <ComboBoxItem>5</ComboBoxItem>
                    <ComboBoxItem>6</ComboBoxItem>
                    <ComboBoxItem>7</ComboBoxItem>
                    <ComboBoxItem>8</ComboBoxItem>
                </ComboBox>
                <CheckBox x:Name="SeparateFoldersBox" Content="Separate folders onto their own row"
                          FontSize="12" Foreground="#FFE8E8F0" Margin="0,0,0,16" />

                <!-- ===== 行为 / Behavior ===== -->
                <TextBlock Text="行为 / Behavior" FontSize="13" FontWeight="Bold" Foreground="#FF8FA0FF" Margin="0,0,0,8" />
                <CheckBox x:Name="ForceTopmostBox" Content="Keep frames always on top"
                          FontSize="12" Foreground="#FFE8E8F0" Margin="0,0,0,10" />

                <!-- New settings: add below, grouped. The window auto-grows and scrolls past MaxHeight. -->

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons pinned at the bottom, always visible -->
        <Border Grid.Row="2" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Padding="20,10,20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Height="30" Margin="0,0,8,0" Background="#FF2A2A3C" Foreground="White" BorderBrush="#44FFFFFF" Click="Cancel_Click" />
                <Button Content="Save"   Width="90" Height="30" Background="#FF5B6CFF" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
